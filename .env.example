# Base URL of the train booking API.
# Server-side only — this value must never be exposed to the browser, so it is
# deliberately not prefixed with NEXT_PUBLIC_.
TRAIN_API_BASE_URL=https://train-booking-assignment.onrender.com

# Absolute base for canonical tags, the sitemap and structured data.
# Defaults to http://localhost:3000.
SITE_URL=https://your-deployment.example
